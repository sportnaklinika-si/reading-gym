      "css": ".ds-tabs{display:grid;grid-template-columns:repeat(3,1fr);background:rgba(11,16,36,.92);border-top:1px solid #283266;padding:4px 8px}.ds-tabs button{position:relative;min-height:52px;background:none;border:0;color:#A6ADCE;font:600 .75rem -apple-system,Segoe UI,Roboto,sans-serif;cursor:pointer}.ds-tabs button:hover{color:#EEF0F8}.ds-tabs button[aria-current=page]{color:#F2BE4A}.ds-tabs button[aria-current=page]::before{content:\"\";position:absolute;top:-5px;left:50%;margin-left:-15px;width:30px;height:3px;border-radius:0 0 3px 3px;background:#F2BE4A}"
