  "narrative": {
    "northStar": "The Award Cabinet",
    "overview": "Reading progress is kept like a sports trophy case. The ground is the deep navy of a medal case’s velvet. Every one of the 18 levels is a cloisonné enamel pin with a plated metal body, a field of its own enamel colour and an icon struck in metal. Bookmarks that save a streak are red silk ribbons. The interface around these objects stays a clean phone app: standard tabs, rows, sheets and buttons, in the cabinet’s palette.\n\nThe app is read in the evening beside a paper book, so it is dark on purpose. While the timer runs the screen drops to near black. Density is calm: one panel per idea, generous rows, large numerals for the numbers that matter (minutes today, streak, level).\n\nIllustrations and pins are authored vector art. Controls never imitate metal; gold on a button is a flat colour.",
    "keyCharacteristics": [
      "Ribbon-navy ground with slightly lighter enamel panels and a one-pixel light top edge.",
      "Gold is what you press; green means goal reached; scarlet means bookmarks and records; cobalt means minutes under the goal.",
      "Rubik Bold for names and numbers, the system sans for everything else.",
      "Level pins change shape by tier: round bronze, hexagonal silver, scalloped gold.",
      "State is carried in shape as well as colour."
    ],
    "rules": [
      {
        "name": "The One Meaning Rule",
        "body": "Each working colour has one job. Green is never used for \"nice\", gold is never used for decoration, scarlet is never used for errors.",
        "section": "colors"
      },
      {
        "name": "The Metal Stays In The Pin Rule",
        "body": "Plating gradients exist only inside pin and rosette illustrations. Buttons, bars and discs are flat.",
        "section": "colors"
      },
      {
        "name": "The No Kicker Rule",
        "body": "No small label above a heading. Level number and hours read sit in a meta line under the level name.",
        "section": "typography"
      }
    ],
    "dos": [
      "**Do** give every new state a distinct shape as well as a colour (disc, ribbon, dashed ring, gold ring).",
      "**Do** keep the running timer screen near black (#04060E) with dimmed text so it can stay on beside a book.",
      "**Do** draw new icons as 24-unit stroke SVG (2px, round caps) so they can be struck into a pin.",
      "**Do** keep text at least 4.5:1 on its panel and tap targets at least 44px."
    ],
    "donts": [
      "**Don’t** put gradients that imitate metal on buttons, bars or discs; metal lives in pins and the rosette only.",
      "**Don’t** nest cards: no tinted tiles inside a panel.",
      "**Don’t** use emoji or text glyphs as icons (no ✓ or ▶); use the drawn SVG.",
      "**Don’t** add a small label above a heading.",
      "**Don’t** pulse or loop motion on the reading screen; the clock already shows it is running."
    ]
  }
}
